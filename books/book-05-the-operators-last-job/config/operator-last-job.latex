  borderline north={0.7pt}{0pt}{systemblue},
  fontupper=\rmfamily\small\itshape,
  title={\ttfamily\scriptsize\color{systemblue}\textsc{The Shift}},
  fonttitle=\ttfamily\scriptsize\bfseries,
  coltitle=systemblue,
  attach title to upper={\par\vspace{-3pt}}
}

% Operator's Note follows the rounded notebox logic in a cooler modern palette.
\newtcolorbox{operatornote}{
