% The Threshold Ledger — Premium editorial layer
% Each component has a different reading function. No generic card system.
% ============================================================================

% ---- Local layout dependency -------------------------------------------------
\usepackage{tabularx}

% ---- Palette -----------------------------------------------------------------
\definecolor{ink}{HTML}{111820}
\definecolor{paper}{HTML}{F4F1EA}
\definecolor{systemblue}{HTML}{3E6278}
\definecolor{signalorange}{HTML}{D96B27}
\definecolor{consequencered}{HTML}{8E3B32}
\definecolor{quietgrey}{HTML}{E7E9E7}
\definecolor{mist}{HTML}{D6D9D4}
\definecolor{slate}{HTML}{5C6A72}
\colorlet{saffron}{signalorange}
\colorlet{vermilion}{consequencered}
\colorlet{actionblue}{signalorange}
\colorlet{warningcoral}{consequencered}
\colorlet{bookaccent}{signalorange}

% ---- Typography and running matter ------------------------------------------
\IfFontExistsTF{Source Serif 4}{\setmainfont{Source Serif 4}}{\setmainfont{TeX Gyre Schola}}
\IfFontExistsTF{IBM Plex Sans}{\setsansfont{IBM Plex Sans}}{\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{JetBrains Mono}{\setmonofont{JetBrains Mono}}{\IfFontExistsTF{IBM Plex Mono}{\setmonofont{IBM Plex Mono}}{\setmonofont{TeX Gyre Cursor}}}
\renewcommand{\familydefault}{\sfdefault}
\AtBeginDocument{\pagecolor{paper}\color{ink}}
\hypersetup{colorlinks=true,linkcolor=systemblue,urlcolor=systemblue,citecolor=systemblue}

% The cover occupies page one. Front matter must begin on page two, not on a forced right-hand page.
\makeatletter
\renewcommand\frontmatter{\clearpage\@mainmatterfalse\pagenumbering{roman}}
\renewcommand\mainmatter{\clearpage\@mainmattertrue\pagenumbering{arabic}}
\makeatother

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[LE,RO]{\sffamily\scriptsize\color{slate}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

% ---- Chapter hierarchy -------------------------------------------------------
\titleformat{\chapter}[display]
  {\thispagestyle{plain}\raggedright}
  {\ttfamily\footnotesize\color{systemblue}\textsc{Chapter}\enspace\thechapter}
  {12pt}
  {\rmfamily\color{ink}\fontsize{27pt}{32pt}\selectfont\bfseries}
\titlespacing*{\chapter}{0pt}{38pt}{25pt}
\titleformat{name=\chapter,numberless}[display]
  {\thispagestyle{plain}\raggedright}{}{0pt}
  {\rmfamily\color{ink}\fontsize{25pt}{30pt}\selectfont\bfseries}
\titlespacing*{name=\chapter,numberless}{0pt}{28pt}{20pt}
\titleformat{\section}
  {\sffamily\bfseries\color{systemblue}\fontsize{13.5pt}{17pt}\selectfont}{}{0pt}{}
\titleformat{\subsection}
  {\sffamily\bfseries\color{ink}\fontsize{10.5pt}{14pt}\selectfont}{}{0pt}{}
\titlespacing*{\section}{0pt}{29pt}{10pt}
\titlespacing*{\subsection}{0pt}{19pt}{6pt}

% ---- Reading thresholds ------------------------------------------------------
% Field note: a light operational trace, with code metadata rather than a dark card.
\renewtcolorbox{fieldnote}{
  enhanced,breakable,boxrule=0.7pt,colframe=slate,
  colback=quietgrey,coltext=ink,
  left=12pt,right=12pt,top=11pt,bottom=10pt,
  before skip=17pt,after skip=22pt,
  fontupper=\rmfamily\normalsize,
  title={\sffamily\scriptsize\color{paper}\textsc{Field Note}},
  fonttitle=\sffamily\scriptsize\bfseries,
  coltitle=paper,colbacktitle=slate,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=8pt,yshift*=-\tcboxedtitleheight/2}
}

% Case signal inherits the warning-note logic used for risk in book 1.
\newtcolorbox{casesignal}{
  enhanced,breakable,boxrule=1.2pt,colframe=consequencered,
  colback=paper,coltext=ink,
  left=12pt,right=12pt,top=11pt,bottom=10pt,
  before skip=23pt,after skip=23pt,
  fontupper=\rmfamily\normalsize,
  title={\sffamily\scriptsize\color{paper}\textsc{Case Signal}},
  fonttitle=\sffamily\scriptsize\bfseries,
  coltitle=paper,colbacktitle=consequencered,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=8pt,yshift*=-\tcboxedtitleheight/2}
}

% The Question: an editorial interruption. Label sits on the line, not in prose.
\newtcolorbox{thequestion}{
  enhanced,breakable,boxrule=0.8pt,colframe=ink,
  colback=paper,coltext=ink,
  left=12pt,right=12pt,top=12pt,bottom=11pt,
  before skip=25pt,after skip=25pt,
  fontupper=\rmfamily\normalsize\itshape\centering,
  title={\sffamily\scriptsize\color{paper}\textsc{The Question}},
  fonttitle=\sffamily\scriptsize\bfseries,
  coltitle=paper,colbacktitle=ink,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=8pt,yshift*=-\tcboxedtitleheight/2}
}

% The Shift borrows the smart, low-noise navigation logic of In This Part.
\newtcolorbox{theshift}{
  enhanced,breakable,frame hidden,boxrule=0pt,
  colback=white,coltext=slate,
  left=0pt,right=8pt,top=9pt,bottom=7pt,
