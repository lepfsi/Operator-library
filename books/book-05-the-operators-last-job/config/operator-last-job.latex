\vbox to \paperheight{\offinterlineskip\hbox to \paperwidth{\includegraphics[width=\paperwidth,height=\paperheight]{$book-cover$}\hss}\vss}
\restoregeometry
\clearpage
$else$
\maketitle
\clearpage
$endif$

\frontmatter
\copyrightpage
\tableofcontents
\mainmatter

$body$

$if(book-back-cover)$
\clearpage
\newgeometry{margin=0pt,noheadfoot}
\thispagestyle{empty}
\vbox to \paperheight{\offinterlineskip\hbox to \paperwidth{\includegraphics[width=\paperwidth,height=\paperheight]{$book-back-cover$}\hss}\vss}
\restoregeometry
$endif$

