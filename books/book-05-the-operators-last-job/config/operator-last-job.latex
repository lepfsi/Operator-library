  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=8pt,yshift*=-\tcboxedtitleheight/2}
}

% Decision Ledger: a dossier tab with a true decision grid inside it.
\newtcolorbox{decisionledger}{
