% ---- Navigation cards ---------------------------------------------------------
% These are deliberately open and typographic rather than UI-like cards.
% Each entry is a full-width hyperlinked tab, not a rendered Markdown bullet.
\newcommand{\partnaventry}[3]{%
  \noindent\hyperlink{#3}{%
    \makebox[28mm][l]{\sffamily\scriptsize\bfseries\color{saffron}CHAPTER~#1}%
    \textcolor{saffron!70}{\raisebox{0.18ex}{\large\textbullet}}\hspace{7pt}%
    {\sffamily\small\color{ink}#2}%
  }\par\vspace{5pt}%
}
\newcommand{\guidenaventry}[3]{%
  \noindent\hyperlink{#3}{%
    \makebox[12mm][l]{\sffamily\scriptsize\bfseries\color{saffron}#1.}%
    \textcolor{saffron!70}{\raisebox{0.12ex}{\normalsize\textbullet}}\hspace{6pt}%
    {\sffamily\small\color{ink}#2}%
  }\par\vspace{4pt}%
}
\newtcolorbox{partmap}{%
  enhanced,unbreakable,arc=0pt,boxrule=0pt,
  colback=paper,colframe=ink,
  borderline north={0.8pt}{0pt}{ink!45},
  borderline south={0.8pt}{0pt}{ink!20},
  left=0pt,right=0pt,top=14pt,bottom=12pt,
  before skip=18pt,after skip=24pt,
  fontupper=\small,
  before upper={\textsc{\footnotesize\color{ink}Inside this part}\par\vspace{7pt}}
}

\newtcolorbox{chapterguidebox}{%
  enhanced,unbreakable,arc=0pt,boxrule=0pt,
  colback=mist!16,colframe=saffron,
  borderline west={1.8pt}{0pt}{saffron},
  left=17pt,right=16pt,top=13pt,bottom=13pt,
  before skip=0pt,after skip=26pt,
  fontupper=\small,
  before upper={\textsc{\footnotesize\color{saffron}Chapter guide}\par\vspace{4pt}\textcolor{saffron!45}{\rule{22mm}{0.45pt}}\par\vspace{8pt}}
}

% ---- Markdown environments mapped by callouts.lua --------------------------
\newenvironment{front-piece}{\begin{frontpiece}}{\end{frontpiece}}
\newenvironment{config-block}{\begin{configblock}}{\end{configblock}}
\newenvironment{field-note}{\begin{fieldnote}}{\end{fieldnote}}
\newenvironment{operating-fact}{\begin{operatingfact}}{\end{operatingfact}}
\newenvironment{next-chapter}{\begin{nextchapter}}{\end{nextchapter}}
\newenvironment{part-map}{\begin{partmap}}{\end{partmap}}
\newenvironment{chapterguide}{\clearpage\begin{chapterguidebox}}{\end{chapterguidebox}}
\newenvironment{chapter-guide}{\begin{chapterguide}}{\end{chapterguide}}
\newenvironment{concept}{\begin{systemconcept}}{\end{systemconcept}}
\newenvironment{warning}{\begin{warningbox}}{\end{warningbox}}
\newenvironment{pitfall}{\begin{warningbox}}{\end{warningbox}}
\newenvironment{operator-rule}{\begin{operatorrule}}{\end{operatorrule}}
\newenvironment{keytakeaways}{\begin{keytakeawaysbox}}{\end{keytakeawaysbox}}
\newenvironment{diagram}{\par\begin{center}\ttfamily\color{slate}\small}{\end{center}\par}
\newenvironment{hookphrase}{\begin{itshape}\color{slate}\small}{\end{itshape}\par}

% ---- Front matter and navigation --------------------------------------------
\renewcommand{\contentsname}{Contents}
% In the book class, chapter is level 0. No section may enter the collection ToC.
\setcounter{tocdepth}{0}
% The collection ToC is quiet, editorial and deliberately lighter than body headings.
\titlecontents{part}[0pt]
  {\addvspace{15pt}\sffamily\footnotesize\scshape\color{saffron}}
  {}{}
  {\hfill\sffamily\footnotesize\color{slate}\contentspage}
\titlecontents{chapter}[12pt]
  {\addvspace{5pt}\sffamily\small\mdseries\color{ink}}
  {\contentslabel{2.4em}}{}
  {\hfill\sffamily\footnotesize\color{slate}\contentspage}

\hypersetup{
  pdftitle={$if(book-pdftitle)$$book-pdftitle$$else$The Operator's Library$endif$},
  pdfauthor={$if(book-author)$$book-author$$else$Author$endif$},
  pdfsubject={IT Operations, Reliability, Resilience}
}

\renewcommand{\maketitle}{%
  \begin{titlepage}\thispagestyle{empty}\centering\vspace*{4cm}
  {\sffamily\scriptsize\scshape\color{slate}\MakeUppercase{$if(book-brand)$$book-brand$$else$THE OPERATOR'S LIBRARY$endif$}}\\[1cm]
  {\sffamily\fontsize{36pt}{40pt}\selectfont\bfseries\color{ink}\MakeUppercase{$if(book-title)$$book-title$$else$THE OPERATOR'S LIBRARY$endif$}}\\[10pt]
  {\itshape\large\color{slate}$if(book-subtitle)$$book-subtitle$$else$$endif$}\\[2cm]
  \textcolor{mist}{\rule{0.6\textwidth}{0.5pt}}\\[1cm]
  {\sffamily\large\color{ink}$if(book-author)$$book-author$$else$AUTHOR$endif$}\par
  $if(book-author-role)$
  {\itshape\normalsize\color{slate}$book-author-role$}\par
  $endif$
  \vfill
  \end{titlepage}
}

\newcommand{\copyrightpage}{%
  \thispagestyle{empty}\vspace*{\fill}\noindent
  \begin{minipage}{\textwidth}\sffamily\scriptsize\color{slate}
  \textcolor{mist}{\rule{0.2\textwidth}{0.4pt}}\\[6pt]
  © $if(book-year)$$book-year$$else$2026$endif$ $if(book-author)$$book-author$$else$AUTHOR$endif$.\\
  Published by \textsc{The Operator's Library}.\\[8pt]
  All rights reserved.
  \end{minipage}\vspace*{\fill}\clearpage
}

