% ---- Final polish: chapter navigation and handoff ---------------------------
% The guide has a soft panel and explicit vertical rhythm, not a compressed paragraph.
\newcommand{\chapterguideentry}[3]{%
  \noindent\hyperref[#3]{%
    \makebox[11mm][l]{\calloutmono\color{teal}#1.}%
    \textcolor{teal!75}{\raisebox{0.12ex}{\normalsize\textbullet}}\hspace{6pt}%
    {\ttfamily\small\color{ink}#2}%
  }\par\vspace{9pt}%
}
\renewtcolorbox{chapterguide}{
  enhanced,breakable,boxrule=0.55pt,arc=6pt,colframe=teal!42,
  colback=mint!68,coltext=ink,
  left=15pt,right=15pt,top=15pt,bottom=14pt,
  before skip=18pt,after skip=24pt,fontupper=\sffamily\small,
  before upper={\noindent\calloutmono\color{teal}\textsc{In This Chapter}\par\vspace{5pt}\textcolor{teal!60}{\rule{34mm}{0.55pt}}\par\vspace{10pt}}
}
% The handoff is intentionally quieter than a callout: a soft tinted strip and a single rule.
\renewtcolorbox{nextchapter}{
  enhanced,breakable,boxrule=0.5pt,arc=6pt,colframe=teal!34,
  colback=mint!62,coltext=ink,
  left=15pt,right=15pt,top=12pt,bottom=10pt,
  before skip=18pt,after skip=18pt,fontupper=\rmfamily\small\itshape,
  before upper={\noindent\calloutmono\color{teal}\textsc{Next Chapter}\par\vspace{4pt}\textcolor{teal!55}{\rule{22mm}{0.45pt}}\par\vspace{8pt}}
}
