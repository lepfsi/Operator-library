  enhanced,unbreakable,boxrule=0.5pt,arc=2pt,colframe=tracecobalt,colback=tracewash,coltext=ink,
  borderline west={3pt}{0pt}{tracecobalt},left=14pt,right=13pt,top=12pt,bottom=11pt,
  before skip=22pt,after skip=22pt,fontupper=\calloutcode,
  title={\calloutmono\color{paper}\textsc{Traceback}},coltitle=paper,colbacktitle=tracecobalt,
  boxed title style={frame hidden,sharp corners},attach boxed title to top left={xshift=9pt,yshift*=-\tcboxedtitleheight/2}
}
\newtcolorbox{dissentrecord}{
  enhanced,breakable,boxrule=0.55pt,arc=9pt,colframe=dissentaubergine,colback=dissentwash,coltext=ink,
  left=15pt,right=14pt,top=13pt,bottom=12pt,before skip=22pt,after skip=22pt,fontupper=\calloutsans,
  title={\calloutmono\color{paper}\textsc{Dissent Record}},coltitle=paper,colbacktitle=dissentaubergine,
  boxed title style={frame hidden,sharp corners},attach boxed title to top left={xshift=10pt,yshift*=-\tcboxedtitleheight/2}
}
\newtcolorbox{handoffnote}{
  enhanced,breakable,boxrule=0.55pt,arc=4pt,colframe=handoffslate,colback=handoffwash,coltext=ink,
  borderline north={1.7pt}{0pt}{handoffslate},left=13pt,right=13pt,top=13pt,bottom=11pt,
  before skip=22pt,after skip=22pt,fontupper=\calloutcode,
  title={\calloutmono\color{paper}\textsc{Handoff Note}},coltitle=paper,colbacktitle=handoffslate,
  boxed title style={frame hidden,sharp corners},attach boxed title to top left={xshift=9pt,yshift*=-\tcboxedtitleheight/2}
}
% -----------------------------------------------------------------------------

% ---- Narrative voice grammar -------------------------------------------------
% These are inline scene markers, not callouts. They clarify agency without cluttering prose.
\definecolor{timeink}{HTML}{405B70}
\definecolor{humanink}{HTML}{365E78}
\definecolor{questionink}{HTML}{70505D}
\definecolor{systemink}{HTML}{526875}
\definecolor{systemwash}{HTML}{EDF2F4}
\newcommand{\livetime}[1]{\textcolor{timeink}{\sffamily\bfseries\footnotesize\textsc{#1}}}
\newcommand{\humanvoice}[1]{\textcolor{humanink}{\sffamily\small #1}}
\newcommand{\operationalquestion}[1]{\textcolor{questionink}{\sffamily\small\bfseries #1}}
\newcommand{\systemvoice}[1]{\begingroup\setlength\fboxsep{2.4pt}\colorbox{systemwash}{\textcolor{systemink}{\ttfamily\footnotesize #1}}\endgroup}
\newcommand{\systemartifact}[1]{\textcolor{systemink}{\ttfamily\footnotesize\textsc{#1}}}
% -----------------------------------------------------------------------------

% ---- Inline voice correction -------------------------------------------------
% System statements stay mono but must wrap with the paragraph; no boxed inline fragments.
\renewcommand{\systemvoice}[1]{{\textcolor{systemink}{\ttfamily\footnotesize #1}}}
% Decision questions are quiet, upright and professional: no purple emphasis or generic italics.
\renewcommand{\operationalquestion}[1]{{\textcolor{noteblue}{\sffamily\footnotesize #1}}}
% -----------------------------------------------------------------------------

% ---- Running navigation ------------------------------------------------------
% Each reading page exposes the book, the current part and the current chapter.
\newcommand{\runningcollection}{\textsc{The Operator's Library}}
\newcommand{\runningpart}{\textsc{Part I \enspace The Operator}}
\fancypagestyle{thresholdledger}{%
  \fancyhf{}
  \fancyhead[LE]{\sffamily\scriptsize\color{slate}\runningcollection}
  \fancyhead[RE]{\sffamily\scriptsize\color{systemblue}\nouppercase{\leftmark}}
  \fancyhead[LO]{\sffamily\scriptsize\color{systemblue}\nouppercase{\leftmark}}
  \fancyhead[RO]{\sffamily\scriptsize\color{slate}\runningcollection}
  \fancyfoot[LE,RO]{\sffamily\scriptsize\color{slate}\thepage}
  \fancyfoot[LO,RE]{\ttfamily\scriptsize\color{slate}\runningpart}
  \renewcommand{\headrulewidth}{0.35pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{teal!55}\leaders\hrule height \headrulewidth\hfill}}
  \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{thresholdledger}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[LE,RO]{\sffamily\scriptsize\color{slate}\thepage}
  \fancyfoot[LO,RE]{\ttfamily\scriptsize\color{slate}\runningpart}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\renewcommand{\chaptermark}[1]{\markboth{Chapter \thechapter\enspace #1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
% -----------------------------------------------------------------------------

% ---- Process-state grammar ---------------------------------------------------
% Short operational states may carry a light background. Long system propositions never do.
\definecolor{timewash}{HTML}{F0F4F6}
\renewcommand{\livetime}[1]{\begingroup\setlength\fboxsep{1.4pt}\colorbox{timewash}{\textcolor{timeink}{\sffamily\bfseries\footnotesize\textsc{#1}}}\endgroup}
\newcommand{\processstate}[1]{\begingroup\setlength\fboxsep{1.7pt}\colorbox{systemwash}{\textcolor{systemink}{\ttfamily\footnotesize #1}}\endgroup}
% -----------------------------------------------------------------------------

% ---- Routine Map ------------------------------------------------------------
\definecolor{routinecopper}{HTML}{96643A}
\definecolor{routinewash}{HTML}{FAF2E9}
\newtcolorbox{routinemap}{
  enhanced,breakable,boxrule=0.60pt,arc=9pt,
  colframe=routinecopper,colback=routinewash,coltext=ink,
  left=12pt,right=12pt,top=16pt,bottom=12pt,boxsep=0pt,
  before skip=15pt,after skip=17pt,
  title={\calloutmono\color{paper}\textsc{Routine Map}},coltitle=paper,colbacktitle=routinecopper,
  attach boxed title to top left={xshift=12pt,yshift*=-\tcboxedtitleheight/2},
  boxed title style={boxrule=0pt,arc=4pt,left=8pt,right=8pt,top=4pt,bottom=4pt},
  fontupper=\calloutcode
}
% -----------------------------------------------------------------------------

% ---- Part-opening identity --------------------------------------------------
\newcommand{\partopening}[5]{%
  \clearpage
  \thispagestyle{empty}%
  \gdef\runningpart{\textsc{Part #1\enspace #2}}%
  \phantomsection
  \pdfbookmark[0]{Part #1: #2}{part-#1}%
  \addcontentsline{toc}{part}{Part #1: #2}%
  \markboth{Part #1\enspace #2}{}%
  \vspace*{25mm}%
  {\color{#4}\rule{\textwidth}{1.1pt}}\par\vspace{12pt}%
  {\ttfamily\footnotesize\color{#4}\textsc{Part #1 \enspace / \enspace New operating question}}\par\vspace{18pt}%
  {\rmfamily\bfseries\color{ink}\fontsize{33pt}{38pt}\selectfont #2\par}%
  \vspace{17pt}%
  {\color{#4}\rule{38mm}{3.1pt}}\par\vspace{20pt}%
  {\rmfamily\color{ink}\fontsize{15pt}{21pt}\selectfont #3\par}%
  \vfill
  {\ttfamily\scriptsize\color{#4}\textsc{#5}}\par
  \vspace*{18mm}%
  \clearpage
}
% -----------------------------------------------------------------------------

% ---- Live dialogue and system-statement refinement -------------------------
% Human speech needs a visible but quiet editorial cue; it is neither code nor body prose.
\renewcommand{\humanvoice}[1]{%
  \par\smallskip\noindent
  {\color{humanink}\rule{1.15pt}{2.35ex}}\hspace{7pt}%
  {\sffamily\small\color{humanink}#1}\par\smallskip
}
% Long diagnostic output is a block-level artefact so it wraps inside the text measure.
\newtcolorbox{systemstatement}{%
  enhanced,breakable,boxrule=0.55pt,arc=4pt,colframe=systemink!72,colback=systemwash,coltext=ink,
  borderline west={2.2pt}{0pt}{systemink},
  left=13pt,right=13pt,top=12pt,bottom=11pt,
  before skip=18pt,after skip=20pt,fontupper=\calloutcode,
  title={\calloutmono\color{paper}\textsc{System Statement}},
  coltitle=paper,colbacktitle=systemink,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=9pt,yshift*=-\tcboxedtitleheight/2}
}
% -----------------------------------------------------------------------------

% ---- Process output and human exchange: final editorial registers ------------
% Process evidence is code-like, structured and deliberately compact.
\newcommand{\processmono}{\ttfamily\fontsize{8.35pt}{13.15pt}\selectfont\color{systemink}}
\renewtcolorbox{systemstatement}{%
  enhanced,breakable,boxrule=0.45pt,arc=3pt,colframe=systemink!58,colback=systemwash,
  left=14pt,right=14pt,top=13pt,bottom=12pt,
  before skip=19pt,after skip=21pt,fontupper=\processmono,
  title={\ttfamily\scriptsize\color{paper}\textsc{Process Output}},
  fonttitle=\ttfamily\scriptsize\bfseries,
  coltitle=paper,colbacktitle=systemink,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=10pt,yshift*=-\tcboxedtitleheight/2}
}
% Human speech is not code and not an AI-style quote card: it is a calm, indented interruption.
\newtcolorbox{humanexchange}{%
  enhanced,breakable,frame hidden,colback=paper,boxrule=0pt,
  left=30pt,right=13pt,top=8pt,bottom=9pt,
  before skip=17pt,after skip=18pt,
  fontupper=\sffamily\fontsize{10.1pt}{15.1pt}\selectfont\color{humanink},
  overlay={\node[anchor=north west,text=humanink!58] at ([xshift=7pt,yshift=-4pt]frame.north west) {\fontsize{23pt}{23pt}\selectfont\textquotedblleft};}
}
% -----------------------------------------------------------------------------

% ---- Design question: a reasoning pivot, not dialogue or system output ------
\newtcolorbox{designquestion}{%
  enhanced,breakable,frame hidden,colback=paper,boxrule=0pt,
  borderline north={0.55pt}{0pt}{systemblue!72},
  borderline south={0.55pt}{0pt}{systemblue!72},
  left=0pt,right=4pt,top=12pt,bottom=13pt,
  before skip=24pt,after skip=25pt,
  before upper={\ttfamily\scriptsize\color{systemblue}\textsc{Operational Question}\par\vspace{8pt}},
  fontupper=\rmfamily\itshape\fontsize{13.1pt}{18.6pt}\selectfont\color{ink}
}
% -----------------------------------------------------------------------------

% ---- Light registers: prose stays primary -----------------------------------
% Short human quotations need a dedicated voice, not a card or a vertical rule.
\renewcommand{\humanvoice}[1]{{\sffamily\itshape\fontsize{9.65pt}{13.6pt}\selectfont\color{humanink}#1}}
% Process Output is evidence, not a second narrative voice. It remains mono, titled,
% and visibly bounded while \,sloppy permits long operational terms to wrap safely.
\renewtcolorbox{systemstatement}{%
  enhanced,breakable,boxrule=0.45pt,arc=3pt,colframe=systemink!58,colback=systemwash,
  left=12pt,right=12pt,top=12pt,bottom=10pt,
  before skip=18pt,after skip=20pt,
  before upper={\raggedright\sloppy\setlength{\emergencystretch}{1.8em}},
  fontupper=\ttfamily\fontsize{8.35pt}{13.2pt}\selectfont\color{systemink},
  title={\ttfamily\scriptsize\color{paper}\textsc{Process Output}},
  fonttitle=\ttfamily\scriptsize\bfseries,
  coltitle=paper,colbacktitle=systemink,
  boxed title style={frame hidden,sharp corners},
  attach boxed title to top left={xshift=10pt,yshift*=-\tcboxedtitleheight/2}
}
% -----------------------------------------------------------------------------
