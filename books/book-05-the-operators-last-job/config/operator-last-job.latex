% ============================================================================
% template.latex — The Operator's Library
% Print system: Technical Editorial / Operational Clarity
% ============================================================================

\documentclass[10pt,twoside,openany]{book}

% ---- Page geometry -----------------------------------------------------------
\usepackage[
  $if(bookformat-a5)$
  papersize={148mm,210mm},
  $else$
  papersize={152.4mm,228.6mm},
  $endif$
  layoutsize={152.4mm,228.6mm},
  twoside,
  inner=22mm,
  outer=18mm,
  top=21mm,
  bottom=22mm,
  headheight=10pt,
  headsep=7mm,
  footskip=11mm
]{geometry}

% ---- Font stack --------------------------------------------------------------
\usepackage{fontspec}
% TeX Gyre is the deterministic baseline and compiles on a clean TeX Live
% installation. The production font trio can be selected after its static files
% have been installed and verified locally; this avoids XeLaTeX font probes
% that can trigger a blocking mktextfm fallback in clean environments.
% Prototype B: a warm, high-x-height reading face plus a neutral humanist sans.
% Both are locally available, so the rendered proof reflects the intended choice.
\setsansfont{TeX Gyre Heros}
\setmainfont{TeX Gyre Schola}
\setmonofont{TeX Gyre Cursor}
% Alternative production stack (static fonts only):
% \setsansfont{Source Sans 3}
% \setmainfont{Source Serif 4}
% \setmonofont{IBM Plex Mono}

% ---- Packages ----------------------------------------------------------------
\usepackage[x11names,dvipsnames]{xcolor}
\usepackage{microtype}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{titletoc}
\usepackage{enumitem}
\usepackage{longtable}
\usepackage{array}
\usepackage{calc}
\usepackage{booktabs}
\usepackage{graphicx}
\usepackage{tikz}
\usepackage{tcolorbox}
\usepackage{xparse}
\usepackage[hidelinks,bookmarksnumbered]{hyperref}
\tcbuselibrary{breakable,skins}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}


% ---- Palette -----------------------------------------------------------------
\definecolor{charcoal}{HTML}{262626}
\definecolor{paper}{HTML}{F2EDE3}
\definecolor{ink}{HTML}{161616}
\definecolor{mist}{HTML}{D8D1C5}
\definecolor{slate}{HTML}{948E84}
\definecolor{saffron}{HTML}{F2A900}
\definecolor{forest}{HTML}{1C6B5A}
\definecolor{vermilion}{HTML}{D95332}
\colorlet{actionblue}{saffron}
\colorlet{warningcoral}{vermilion}
\definecolor{chalk}{HTML}{FBF7EF}
$if(book-accent)$\definecolor{bookaccent}{HTML}{$book-accent$}
$else$\definecolor{bookaccent}{HTML}{F2A900}
$endif$
\pagecolor{paper}\color{ink}

% ---- Core type and spacing ---------------------------------------------------
\raggedbottom
\AtBeginDocument{\fontsize{10.3pt}{15.4pt}\selectfont}
% Open paragraphs improve the reading rhythm of this short-form operational essay.
% No first-line indents: spacing, not tabs, separates units of thought.
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt minus 1pt}
\setlength{\emergencystretch}{1.25em}
\widowpenalty=10000
\clubpenalty=10000
\setlist[itemize]{leftmargin=18pt,topsep=6pt,parsep=0pt,itemsep=3pt}
\setlist[enumerate]{leftmargin=21pt,topsep=6pt,parsep=0pt,itemsep=4pt}
\renewcommand{\labelitemi}{\color{saffron}\textendash}

% ---- Running furniture -------------------------------------------------------
% Normal pages carry navigation only. Display, part and chapter opening pages
% use the plain style defined below and remain deliberately free of furniture.
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\fancyhead[LE]{\sffamily\footnotesize\scshape\color{slate}$if(book-head)$$book-head$$else$THE OPERATOR'S LIBRARY$endif$}
\fancyhead[RO]{\sffamily\footnotesize\scshape\color{slate}\nouppercase{\leftmark}}
\fancyfoot[LE,RO]{\sffamily\footnotesize\color{ink}\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{mist}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

% ---- Headings ----------------------------------------------------------------
\titleclass{\part}{top}
\titleformat{\part}[display]
  {\centering\sffamily}
  {\color{actionblue}\fontsize{24pt}{28pt}\selectfont\bfseries PART\ \thepart}
  {18pt}
  {\color{ink}\fontsize{20pt}{24pt}\selectfont\bfseries\scshape}
\titlespacing*{\part}{0pt}{48pt}{42pt}

\titleclass{\chapter}{top}
\titleformat{\chapter}[display]
  {\thispagestyle{plain}\sffamily}
  {\color{saffron}\footnotesize\scshape\bfseries Chapter\enspace\thechapter}
  {13pt}
  {\color{ink}\fontsize{28pt}{33pt}\selectfont\bfseries}
\titlespacing*{\chapter}{0pt}{44pt}{28pt}
\titleformat{name=\chapter,numberless}[display]
  {\thispagestyle{plain}\sffamily}
  {}
  {0pt}
  {\color{ink}\fontsize{26pt}{31pt}\selectfont\bfseries}
\titlespacing*{name=\chapter,numberless}{0pt}{44pt}{26pt}

\titleformat{\section}
  {\sffamily\bfseries\color{saffron}\fontsize{16pt}{20pt}\selectfont}
  {}{0pt}{}
\titleformat{\subsection}
  {\sffamily\bfseries\color{ink}\fontsize{11pt}{14pt}\selectfont}
  {}{0pt}{}
\titlespacing*{\section}{0pt}{28pt}{10pt}
\titlespacing*{\subsection}{0pt}{18pt}{6pt}

% ---- Front pieces -------------------------------------------------------------
% Foreword and Introduction are quiet reading thresholds, not chapter openings.
\NewDocumentEnvironment{frontpiece}{O{FOREWORD}}{%
  \newpage\markboth{}{}\thispagestyle{plain}%
  \vspace*{18mm}%
  \begingroup\rightskip=0.18\textwidth\relax%
  {\sffamily\scriptsize\scshape\color{slate}#1\par}%
  \vspace{13pt}%
  \textcolor{mist}{\rule{28mm}{0.45pt}}\par\vspace{15pt}%
  \rmfamily\fontsize{10.5pt}{16.4pt}\selectfont\color{ink}%
}{%
  \par\endgroup\vfill\thispagestyle{plain}%
}

% ---- Impact pages ------------------------------------------------------------
% Attributes from Markdown: ::: {.impact-opener number="01" title="BEYOND..."}
\NewDocumentEnvironment{impact-opener}{O{\thechapter} O{$if(book-title)$$book-title$$else$BEYOND THE FIREWALL$endif$}}{%
  \clearpage\refstepcounter{chapter}\addcontentsline{toc}{chapter}{#2}\markboth{#2}{}%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[charcoal] (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}%
  \vspace*{\fill}
  \begin{flushright}
    {\sffamily\bfseries\fontsize{180pt}{180pt}\selectfont\color{saffron!30}#1}\par
  \end{flushright}
  \vfill
  \begin{flushright}
    {\sffamily\bfseries\fontsize{42pt}{48pt}\selectfont\color{chalk}\MakeUppercase{#2}}\par
  \end{flushright}
  \vspace*{15mm}
}{\clearpage}

% Parts are thresholds, not oversized chapter headings. Their construction is
% intentionally spare: a single numeral, a title, and a concise editorial cue.
\NewDocumentEnvironment{part-opener}{O{} O{PART}}{%
  \clearpage\markboth{#2}{}\phantomsection\addcontentsline{toc}{part}{Part #1: #2}\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[charcoal] (current page.south west) rectangle (current page.north east);
    \draw[saffron,line width=1.2pt] ([xshift=18mm,yshift=-27mm]current page.north west) -- ([xshift=72mm,yshift=-27mm]current page.north west);
  \end{tikzpicture}%
  \vspace*{38mm}%
  {\sffamily\footnotesize\scshape\bfseries\color{saffron}PART\enspace #1\par}
  \vspace{12pt}%
  {\sffamily\fontsize{31pt}{37pt}\selectfont\bfseries\color{chalk}\MakeUppercase{#2}\par}
  \vspace{16pt}%
  {\color{chalk!62}\rule{34mm}{0.6pt}\par}
  \vfill
  {\sffamily\small\color{chalk!72}THE OPERATOR'S LIBRARY\par}
  \vspace*{23mm}%
}{\clearpage}

\newenvironment{impact-quote}{%
  \clearpage\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[paper] (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}%
  \vspace*{\fill}\begin{center}
  \itshape\fontsize{40pt}{48pt}\selectfont\color{ink}
}{%
  \end{center}\vspace{14pt}%
  \begin{center}\color{mist}\rule{30mm}{0.8pt}\end{center}%
  \vspace*{\fill}\clearpage
}

